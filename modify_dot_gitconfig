#!/usr/bin/env bash
# Ensures the chezmoi-owned git config block is present in ~/.gitconfig
# without clobbering anything else the user has added there manually.
# chezmoi feeds the current file content to this script's stdin and writes
# stdout back.
#
# Signing key must also be present in the target user's GitHub account
# and in each host's sops-rendered allowed_signers file
# (see flake/hosts/omen15/omen15.nix in the flake source).
set -euo pipefail

BEGIN="# BEGIN chezmoi-managed git config (see dot_config/git in dotfiles repo)"
END="# END chezmoi-managed git config"

has_ssh_identity() {
    local f
    for f in id_ed25519 id_ecdsa id_rsa id_ed25519_sk id_ecdsa_sk; do
        [ -f "$HOME/.ssh/$f" ] && return 0
    done
    ssh-add -l >/dev/null 2>&1
}

ssh_block=""
if has_ssh_identity; then
    ssh_block="$(
        cat <<'EOF'
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
EOF
    )"
fi

block="$(
    cat <<EOF
$BEGIN
[commit]
	gpgsign = true
[gpg]
	format = ssh
$ssh_block
$END
EOF
)"

current="$(cat)"

if grep -qF "$BEGIN" <<<"$current"; then
    awk -v b="$BEGIN" -v e="$END" -v block="$block" '
    $0==b {print block; skip=1; next}
    $0==e {skip=0; next}
    skip {next}
    {print}
  ' <<<"$current"
else
    printf '%s\n\n%s\n' "$current" "$block"
fi
